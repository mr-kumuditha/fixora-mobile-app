rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function isCustomer() {
      return signedIn() && exists(userPath(request.auth.uid)) &&
        get(userPath(request.auth.uid)).data.role == 'CUSTOMER';
    }
    function ownsRepair(data) {
      return isCustomer() && data.customerId == request.auth.uid;
    }
    function validOwnUserCreate(uid) {
      return request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        request.resource.data.uid == uid &&
        request.resource.data.role == 'CUSTOMER';
    }
    function validOwnProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'photoUrl', 'updatedAt']) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == 'CUSTOMER' &&
        request.resource.data.createdAt == resource.data.createdAt;
    }
    function validNewRepair() {
      return request.resource.data.keys().hasOnly([
          'customerId', 'serviceId', 'deviceDetails', 'issueDescription', 'imageUrls',
          'branchId', 'technicianId', 'status', 'createdAt', 'scheduledAt', 'completedAt'
        ]) &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.serviceId is string &&
        request.resource.data.issueDescription is string &&
        request.resource.data.imageUrls is list &&
        request.resource.data.branchId is string &&
        request.resource.data.technicianId == null &&
        request.resource.data.status == 'SUBMITTED' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.completedAt == null;
    }
    function validCustomerCompletion() {
      return ownsRepair(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']) &&
        resource.data.status == 'READY_FOR_PICKUP' &&
        request.resource.data.status == 'COMPLETED' &&
        request.resource.data.completedAt == request.time;
    }
    function ownsRepairRequest(repairRequestId) {
      return isCustomer() &&
        get(/databases/$(database)/documents/repairRequests/$(repairRequestId)).data.customerId == request.auth.uid;
    }
    function validPayment() {
      return request.resource.data.keys().hasOnly([
          'repairRequestId', 'amount', 'method', 'status', 'receiptId', 'createdAt'
        ]) &&
        request.resource.data.repairRequestId is string &&
        request.resource.data.amount is number && request.resource.data.amount > 0 &&
        request.resource.data.method in ['CARD', 'CASH_ON_PICKUP'] &&
        request.resource.data.status in ['SUCCESS', 'FAILED'] &&
        request.resource.data.receiptId is string &&
        request.resource.data.receiptId.size() > 0 &&
        request.resource.data.createdAt == request.time;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && validOwnUserCreate(uid);
      allow update: if signedIn() && request.auth.uid == uid && validOwnProfileUpdate();
      allow delete: if false;
    }
    match /services/{serviceId} {
      allow read: if isCustomer();
      allow write: if false;
    }
    match /branches/{branchId} {
      allow read: if isCustomer();
      allow write: if false;
    }
    match /repairRequests/{requestId} {
      allow read: if ownsRepair(resource.data);
      allow create: if isCustomer() && validNewRepair();
      allow update: if validCustomerCompletion();
      allow delete: if false;
    }
    match /payments/{paymentId} {
      allow read: if ownsRepairRequest(resource.data.repairRequestId);
      allow create: if ownsRepairRequest(request.resource.data.repairRequestId) && validPayment();
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
